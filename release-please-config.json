{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "include-component-in-tag": false,
  "include-v-in-tag": true,
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": false,
  "pull-request-header": "Релиз собран из заголовков вмерженных PR. Мерж этого PR ставит тег версии и публикует релиз на GitHub; сайт обновляется с каждым мержем в main как обычно.",
  "changelog-sections": [
    { "type": "feat", "section": "Новое" },
    { "type": "fix", "section": "Исправления" },
    { "type": "perf", "section": "Быстрее" },
    { "type": "revert", "section": "Откаты" },
    { "type": "deps", "section": "Зависимости" },
    { "type": "docs", "section": "Документация", "hidden": true },
    { "type": "refactor", "section": "Внутри", "hidden": true },
    { "type": "test", "section": "Тесты", "hidden": true },
    { "type": "ci", "section": "CI", "hidden": true },
    { "type": "build", "section": "Сборка", "hidden": true },
    { "type": "style", "section": "Стиль", "hidden": true },
    { "type": "chore", "section": "Прочее", "hidden": true }
  ],
  "packages": {
    ".": {
      "package-name": "bus",
      "changelog-path": "CHANGELOG.md",
      "extra-files": ["src/version.ts"]
    }
  }
}
