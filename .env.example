# Локальная разработка: обычно ничего задавать не нужно — база будет в data/bus.sqlite, вход выключен.
#   cp .env.example .env
# Облако (Vercel) задаёт переменные в настройках проекта — см. README, раздел «Деплой».

# Порт локального API (Vite проксирует на него /api и /mcp)
# API_PORT=5055

# --- только для облака ---
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# ADMIN_GITHUB_USERS=your-github-login        # главные админы, через запятую
# BETTER_AUTH_URL=https://bus.akapps.click
# BETTER_AUTH_SECRET=                          # openssl rand -hex 32
# TURSO_DATABASE_URL=                          # ставит интеграция Turso в Vercel
# TURSO_AUTH_TOKEN=
